<?xml version="1.0" encoding="utf-8"?>
<!--
  Il segno del multiroom: tre stanze di dimensioni diverse, un altoparlante per
  stanza, e la stessa onda che le attraversa tutte.

  Disegno originale, non il logo del progetto Snapcast: quello e' un marchio
  loro, e riprodurlo dentro un'altra app non sarebbe corretto. Questo dice la
  stessa cosa — lo stesso suono in piu' stanze, allo stesso istante — con forme
  che sono nostre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Le tre stanze. La centrale e' piu' alta: e' quella in cui sei. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M2.75,9.75 h4.5 v8 h-4.5 z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M9.75,6.75 h4.5 v11 h-4.5 z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M16.75,9.75 h4.5 v8 h-4.5 z" />

    <!-- Un altoparlante per stanza. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5,13.75 m-1.15,0 a1.15,1.15 0 1,0 2.3,0 a1.15,1.15 0 1,0 -2.3,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12.25 m-1.35,0 a1.35,1.35 0 1,0 2.7,0 a1.35,1.35 0 1,0 -2.7,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19,13.75 m-1.15,0 a1.15,1.15 0 1,0 2.3,0 a1.15,1.15 0 1,0 -2.3,0 z" />

    <!-- L'onda che le attraversa: e' la stessa, ed e' il punto di tutto. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M1.25,4 c2.5,-2.4 5,-2.4 7.5,0 c2.5,2.4 5,2.4 7.5,0 c1.6,-1.55 3.2,-2.15 4.8,-1.8" />
