<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 e precedenti. Stessa regola di data_extraction_rules.xml: il file
    dei segreti non esce dal dispositivo, perche' la chiave che lo apre non esce
    dal Keystore.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="wfas_secrets.xml" />
</full-backup-content>
