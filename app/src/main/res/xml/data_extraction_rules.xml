<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 e successivi.

    Il file dei segreti e' cifrato con una chiave che vive nel Keystore e non
    esce dal dispositivo: portarselo dietro produrrebbe solo un blob illeggibile,
    quindi si esclude sia dal backup cloud sia dal trasferimento fra dispositivi.
    Il token di automazione deve restare legato al telefono che lo ha generato.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wfas_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wfas_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
