<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later.

    The secrets file is encrypted with a key that lives in the Keystore and does
    not leave the device, so carrying it anywhere would only produce an
    unreadable blob: it is excluded from both cloud backup and device transfer,
    and the automation token stays tied to the phone that generated it.

    The settings DataStore no longer holds any secret — the pre-shared key moved
    into the same encrypted file as the token — but it stays excluded for a
    different reason: it holds the highest multicast epoch accepted from each
    server, and restoring an old copy of that would wind the replay floor back
    and let beacons this device has already rejected through again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wfas_secrets.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wfas_secrets.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
